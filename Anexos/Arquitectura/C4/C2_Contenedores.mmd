C4Container
title Diagrama de Contenedores — ANPR VISION

Person(admin, "Administrador del Sistema")
Person(employee, "Empleado")
Person(user, "Usuario Final")
Person(camera, "Cámara ANPR")

System_Boundary(s1, "ANPR VISION") {
    Container(backend, "Backend API", "ASP.NET Core", "Gestiona la lógica de negocio, API REST, Kafka y SignalR.")
    ContainerDb(db, "Base de Datos", "PostgreSQL", "Almacena usuarios, vehículos, tarifas, notificaciones y registros de ingreso/salida.")
    Container(micro, "Microservicio ANPR", "Python + OpenCV + YOLOv5", "Procesa imágenes para detectar matrículas y genera eventos Kafka.")
    Container(web, "Frontend Web", "Angular", "Interfaz administrativa y panel de control.")
    Container(app, "App Móvil", "Ionic / Capacitor", "Permite a usuarios finales consultar información y alertas.")
    Container(msg, "Broker de Mensajes", "Apache Kafka", "Canal de comunicación entre el microservicio y el backend.")
}

Rel(camera, micro, "Envía video o imágenes")
Rel(micro, msg, "Publica eventos de detección de placas (Kafka Topic)")
Rel(backend, msg, "Consume eventos (Kafka Consumer)")
Rel(backend, db, "Lee y escribe datos")
Rel(backend, web, "Provee API REST + SignalR en tiempo real")
Rel(backend, app, "Provee API REST + WebSocket")
Rel(admin, web, "Gestiona la configuración del sistema")
Rel(employee, web, "Consulta estado, registra vehículos manualmente")
Rel(user, app, "Consulta historial, alertas y pagos")
